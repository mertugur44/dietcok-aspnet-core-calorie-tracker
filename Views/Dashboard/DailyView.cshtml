@{
    var date = ViewBag.Date;
    var groupedConsumptions = ViewBag.GroupedConsumptions as Dictionary<MealType, List<Consumption>>;
    var mealTotals = ViewBag.MealTotals as Dictionary<MealType, int>;
    var totalCalories = ViewBag.TotalCalories;
    var totalProtein = ViewBag.TotalProtein;
    var totalCarbs = ViewBag.TotalCarbs;
    var totalFat = ViewBag.TotalFat;
    var isOverLimit = (bool)ViewBag.IsOverLimit;
    var foods = ViewBag.Foods as List<Food>;
    var userGoal = ViewBag.UserGoal;
}

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.select2-food').select2({
                placeholder: "Besin aramak için yazın...",
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}

<style>
    .daily-title-row {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }
    .back-btn {
        text-decoration: none;
        font-size: 1.5em;
        font-weight: bold;
        color: #4a5568;
        padding: 5px 12px;
        background: #edf2f7;
        border-radius: 50%;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
    }
    .back-btn:hover {
        background: #cbd5e0;
        color: #2d3748;
    }
    .summary-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 30px;
        border-radius: 16px;
        margin-bottom: 30px;
        color: white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }
    .summary-card.on-track {
        background: linear-gradient(135deg, #28a745 0%, #218838 100%);
    }
    .summary-card.over-limit {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
    }
    .summary-label {
        font-size: 0.9em;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.9;
    }
    .summary-stat-big {
        font-size: 3em;
        font-weight: 800;
        line-height: 1;
        margin: 5px 0;
    }
    .macro-stat {
        text-align: center;
        background: rgba(255, 255, 255, 0.15);
        padding: 12px 20px;
        border-radius: 12px;
        min-width: 90px;
        backdrop-filter: blur(5px);
    }
    .macro-val {
        font-size: 1.5em;
        font-weight: bold;
    }
    .macro-label {
        font-size: 0.75em;
        opacity: 0.9;
        margin-top: 4px;
    }
    .add-food-card {
        background: white;
        padding: 25px 30px;
        border-radius: 16px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.03);
        margin-bottom: 30px;
        border: 1px solid rgba(0,0,0,0.03);
    }
    .modern-form {
        display: flex;
        gap: 20px;
        align-items: flex-end;
        flex-wrap: wrap;
    }
    .btn-add {
        background: #28a745;
        color: white;
        font-weight: bold;
        padding: 0 30px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .btn-add:hover {
        background: #218838;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(40,167,69,0.3);
    }
    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #4a5568;
    }
</style>

<div class="daily-title-row">
    <a href="/dashboard" class="back-btn" title="Geri Dön">&larr;</a>
    <h2 style="margin:0;">Günlük Özet: @date</h2>
</div>

<div class="summary-card @(isOverLimit ? "over-limit" : "on-track")">
    <div style="display: flex; gap: 40px; align-items: center; flex-wrap: wrap;">
        <div>
            <div class="summary-label">Kalori</div>
            <div class="summary-stat-big">@totalCalories</div>
            <div class="summary-label" style="opacity:0.8;">/ @userGoal kcal</div>
        </div>

        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
            <div class="macro-stat">
                <div class="macro-val">@totalProtein</div>
                <div class="macro-label">Protein (g)</div>
            </div>
            <div class="macro-stat">
                <div class="macro-val">@totalCarbs</div>
                <div class="macro-label">Karbonhidrat (g)</div>
            </div>
            <div class="macro-stat">
                <div class="macro-val">@totalFat</div>
                <div class="macro-label">Yağ (g)</div>
            </div>
        </div>
    </div>

    <div style="text-align:right;">
        <div style="font-size:3em;">
            @(isOverLimit ? "⚠️" : "🔥")
        </div>
        <div style="font-weight:bold; font-size:1.2em;">
            @(isOverLimit ? "Hedef Aşıldı" : "Hedefte")
        </div>
    </div>
</div>

<div class="add-food-card">
    <h3 style="margin-top:0; margin-bottom:20px; color:#495057;">+ Öğün Ekle</h3>
    <form action="/consumption/add" method="post" class="modern-form">
        <input type="hidden" name="date" value="@date" />

        <div class="form-group" style="min-width: 150px;">
            <label>Öğün Tipi</label>
            <select name="mealType" class="form-control" style="height:42px;">
                <option value="BREAKFAST">🍳 Kahvaltı</option>
                <option value="LUNCH">🥗 Öğle Yemeği</option>
                <option value="DINNER">🍲 Akşam Yemeği</option>
                <option value="SNACK">🍎 Ara Öğün</option>
            </select>
        </div>

        <div class="form-group" style="flex-grow: 2; min-width: 250px;">
            <label>Besin Seçimi</label>
            <select name="foodId" class="form-control select2-food" required>
                <option value=""></option>
                @foreach (var food in foods ?? new List<Food>())
                {
                    <option value="@food.Id">@food.Name (@food.Calories kcal/100g)</option>
                }
            </select>
        </div>

        <div class="form-group" style="min-width: 100px;">
            <label>Miktar (x100g)</label>
            <input type="number" step="0.1" name="amount" value="1.0" class="form-control" style="height:24px;" required />
        </div>

        <button type="submit" class="btn-add">Ekle</button>
    </form>
</div>

<h3 style="color:#495057; margin-bottom:20px;">Bugünün Kayıtları</h3>

<div class="meal-grid">
    @foreach (var entry in groupedConsumptions ?? new Dictionary<MealType, List<Consumption>>())
    {
        <div class="meal-card">
            <div class="meal-header">
                <h3>
                    @switch (entry.Key)
                    {
                        case MealType.BREAKFAST:
                            <span>🍳 Kahvaltı</span>
                            break;
                        case MealType.LUNCH:
                            <span>🥗 Öğle Yemeği</span>
                            break;
                        case MealType.DINNER:
                            <span>🍲 Akşam Yemeği</span>
                            break;
                        case MealType.SNACK:
                            <span>🍎 Ara Öğün</span>
                            break;
                    }
                </h3>
                <span class="meal-total">
                    @(mealTotals?.ContainsKey(entry.Key) == true ? mealTotals[entry.Key] : 0) kcal
                </span>
            </div>

            @if (entry.Value == null || entry.Value.Count == 0)
            {
                <div style="color:#cbd5e0; font-style:italic; padding:10px 0;">
                    Bu öğün için kayıt yok.
                </div>
            }
            else
            {
                <table class="compact-table">
                    <thead>
                        <tr>
                            <th>Besin</th>
                            <th>Miktar</th>
                            <th>Kalori</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in entry.Value)
                        {
                            <tr>
                                <td style="font-weight:500;">@c.Food.Name</td>
                                <td>@c.Amount x 100g</td>
                                <td style="font-weight:bold; color:#28a745;">
                                    @Math.Round(c.Food.Calories * c.Amount)
                                </td>
                                <td style="text-align:right;">
                                    <form action="/consumption/delete" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <input type="hidden" name="date" value="@date" />
                                        <button type="submit" style="background:none; border:none; color:#ff6b6b; font-weight:bold; font-size:1.3em; cursor:pointer; padding:0; line-height:1;">&times;</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>
