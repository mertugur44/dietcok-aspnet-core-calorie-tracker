@model CalorieTracker.Models.User

<style>
    .back-btn {
        text-decoration: none;
        font-size: 1.5em;
        font-weight: bold;
        color: #4a5568;
        padding: 5px 12px;
        background: #edf2f7;
        border-radius: 50%;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
    }
    .back-btn:hover {
        background: #cbd5e0;
        color: #2d3748;
    }
</style>

<div style="margin-bottom: 20px;">
    <a href="/dashboard" class="back-btn" title="Geri Dön">&larr;</a>
</div>

<div class="auth-card" style="margin: 0 auto; max-width: 500px; text-align: left;">
    <div class="auth-header" style="text-align: center;">
        <h2>Profil Ayarları</h2>
        <p>Hedeflerinizi güncelleyin</p>
    </div>

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="success" style="color:green; margin-bottom:15px; background:#eaffea; padding:10px; border-radius:5px; text-align:center;">
            ✅ @ViewBag.SuccessMessage
        </div>
    }

    <form action="/profile/update-goal" method="post">
        <div class="form-group">
            <label>Kullanıcı Adı</label>
            <input type="text" value="@Model.Username" class="form-control" disabled style="background-color: #e9ecef;" />
            <small style="color:#aaa;">Kullanıcı adı değiştirilemez.</small>
        </div>

        <div class="form-group">
            <label>Günlük Hedef Kalori (kcal)</label>
            <input type="number" name="dailyCalorieGoal" value="@Model.DailyCalorieGoal" class="form-control" required />
            <small style="color: #28a745; font-weight: bold;">Bu değeri değiştirirseniz, takvimdeki renkler buna göre yeniden hesaplanır.</small>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-top: 15px;">
            <div class="form-group">
                <label>Protein (g)</label>
                <input type="number" name="dailyProteinGoal" value="@Model.DailyProteinGoal" class="form-control" placeholder="Örn: 150" />
            </div>
            <div class="form-group">
                <label>Karbonhidrat (g)</label>
                <input type="number" name="dailyCarbGoal" value="@Model.DailyCarbGoal" class="form-control" placeholder="Örn: 200" />
            </div>
            <div class="form-group">
                <label>Yağ (g)</label>
                <input type="number" name="dailyFatGoal" value="@Model.DailyFatGoal" class="form-control" placeholder="Örn: 70" />
            </div>
        </div>

        <button type="submit" class="auth-btn" style="margin-top: 20px;">Kaydet</button>
    </form>
</div>
